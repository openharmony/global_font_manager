#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("//build/config/components/idl_tool/idl.gni")
import("../../../frameworks/fontmgr/fontmgr.gni")
##############################fuzztest##########################################

ohos_fuzztest("ServiceDataMigrationFuzzTest") {
  module_out_path = "font_manager/font_manager_fuzz"
  fuzz_config_file = "//base/global/font_manager/test/fuzztest/servicedatamigration_fuzzer"
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  include_dirs = [
    "../common",
    "../utils",
    "../../../service/client/include",
    "../../../common/include",
    "../../../frameworks/fontmgr/include",
  ]
  sources = [
    "fuzzer.cpp",
    "../utils/fuzz_data.cpp",
  ]

  deps = [
    "../../../service:font_manager_client",
    "../../../service:font_manager_server",
    "../../../service:font_service_interface",
    "../../fuzztest:font_manager_fuzz_permission",
  ]
    
  external_deps = [
    "ability_runtime:ability_manager",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
    "safwk:system_ability_fwk",
    "eventhandler:libeventhandler",
    "hisysevent:libhisysevent",
  ]

  external_deps += fontmgr_external_deps

  os_account_enable = false
  if (defined(global_parts_info) && defined(global_parts_info.account_os_account)) {
    os_account_enable = true
  }

  if (os_account_enable) {
    external_deps += [ "os_account:os_account_innerkits" ]
    defines = [ "ACCOUNT_ENABLE" ]
  }
}

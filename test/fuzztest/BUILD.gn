import("//build/test.gni")

ohos_source_set("font_manager_fuzz_permission") {
  include_dirs = [
  ]

  sources = [
    "common/permission_common.cpp",
  ]

  public_external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "access_token:libnativetoken",
    "access_token:libtoken_setproc",
  ]

  part_name = "font_manager"
  subsystem_name = "global"
}

group("fuzztest") {
  testonly = true
  deps = []

  deps += [
    # deps file
    "serviceinstallfont_fuzzer:ServiceInstallFontFuzzTest",
    "serviceuninstallfont_fuzzer:ServiceUnInstallFontFuzzTest",
    "servicedatamigration_fuzzer:ServiceDataMigrationFuzzTest",
  ]
}

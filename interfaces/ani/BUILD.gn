import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")

config("fontmgr_ani_config") {
  include_dirs = [
    "include",
    "../../frameworks/fontmgr/include",
  ]
}

generate_static_abc("fontManager") {
  base_url = "./ets"
  files = [ "./ets/@ohos.fontManager.ets" ]
  is_boot_abc = "True"
  device_dst_file = "system/framework/fontManager.abc"
}

ohos_prebuilt_etc("fontManager_etc") {
  source = "$target_out_dir/fontManager.abc"
  module_install_dir = "framework"
  part_name = "font_manager"
  subsystem_name = "global"
  deps = [ ":fontManager" ]
}

ohos_shared_library("fontManager_ani") {
  public_configs = [ ":fontmgr_ani_config" ]
  public_configs += [ "../../service:font_client_config" ]
  sources = [ "src/font_manager_ani.cpp" ]

  deps = [ "../../service:font_manager_client" ]

  version_script = "fontManager_ani.map"

  external_deps = [
    "hilog:libhilog",
    "ipc:ipc_core",
    "runtime_core:ani",
  ]

  branch_protector_ret = "pac_ret"

  relative_install_dir = "module"
  subsystem_name = "global"
  part_name = "font_manager"
}

group("ani_package_font_manager") {
  deps = [
    ":fontManager_ani",
    ":fontManager_etc",
  ]
}

import("//build/ohos.gni")

config("fontmgr_napi_config") {
  include_dirs = [
    "include",
    "../../../common/include",
  ]
}

ohos_shared_library("fontmanager") {
  public_configs = [ ":fontmgr_napi_config" ]
  public_configs += [ "../../../service:font_client_config" ]

  sources = [
    "src/font_manager_addon.cpp",
    "src/font_manager_napi.cpp",
    "src/js_data_migration_listener.cpp",
    "src/js_func_ref_holder.cpp",
    "../../../service/client/src/font_client_observer_agent.cpp",
    "$root_gen_dir/base/global/font_manager/service/font_client_observer_stub.cpp",
  ]

  deps = [
    "../../../service:font_manager_client",
    "../../../service:font_service_interface",
  ]

  external_deps = [
    "ability_runtime:runtime",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "napi:ace_napi",
    "node:node_header_notice",
    "libuv:uv",
  ]

  cflags_cc = [
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-Os",
  ]

  branch_protector_ret = "pac_ret"

  relative_install_dir = "module"
  subsystem_name = "global"
  part_name = "font_manager"
}
